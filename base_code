def build_context(
    results: list[SearchResult],
    max_chars: int,
) -> tuple[str, list[dict]]:

    sections = []

    sources = []

    current_size = 0

    for number, result in enumerate(
        results,
        start=1,
    ):

        chunk = result.chunk

        section = (
            f"[Source {number}]\n"
            f"File: {chunk.file_name}\n"
            f"Page: {chunk.page}\n"
            f"Retrieval score: {result.score:.4f}\n"
            f"Semantic score: "
            f"{result.semantic_score:.4f}\n"
            f"Content:\n"
            f"{chunk.text}\n"
        )

        if (
            current_size
            + len(section)
            > max_chars
        ):
            break

        sections.append(
            section
        )

        sources.append(
            {
                "number": number,
                "file_name": chunk.file_name,
                "page": chunk.page,
                "chunk_id": chunk.chunk_id,
                "score": round(
                    result.score,
                    4,
                ),
            }
        )

        current_size += len(section)

    return (
        "\n---\n".join(sections),
        sources,
    )


def build_user_prompt(
    question: str,
    context: str,
) -> str:

    return f"""
Research question:
{question}

Retrieved context:
{context}

Answer the question using only this context.
Use [1], [2], etc. for citations.
""".strip()


