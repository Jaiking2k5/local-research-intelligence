def command_reset(
    args: argparse.Namespace,
) -> None:

    files = [
        INDEX_FILE,
        CHUNKS_FILE,
        DATABASE_FILE,
    ]

    deleted = 0

    for path in files:

        if path.exists():

            path.unlink()

            deleted += 1

            logging.info(
                "Deleted %s",
                path,
            )

    print(
        f"Reset completed. "
        f"Deleted {deleted} files."
    )


# ============================================================
# ARGUMENT PARSER
# ============================================================

def build_parser() -> argparse.ArgumentParser:

    parser = argparse.ArgumentParser(
        description=(
            "Local Research Intelligence "
            "& Agentic RAG"
        )
    )

    parser.add_argument(
        "--embedding-model",
        default=DEFAULT_EMBEDDING_MODEL,
        help="Sentence Transformer model.",
    )

    parser.add_argument(
        "--ollama-url",
        default=DEFAULT_OLLAMA_URL,
        help="Local Ollama URL.",
    )

    parser.add_argument(
        "--ollama-model",
        default=DEFAULT_OLLAMA_MODEL,
        help="Ollama model.",
    )

    subparsers = (
        parser.add_subparsers(
            dest="command",
            required=True,
        )
    )

    # --------------------------------------------------------
    # INGEST
    # --------------------------------------------------------

    ingest_parser = (
        subparsers.add_parser(
            "ingest",
            help=(
                "Extract, chunk, embed, "
                "and index PDFs."
            ),
        )
    )

    ingest_parser.add_argument(
        "--docs",
        default=str(
            DOCUMENTS_DIR
        ),
        help="PDF directory.",
    )

    ingest_parser.add_argument(
        "--chunk-size",
        type=int,
        default=DEFAULT_CHUNK_SIZE,
    )

    ingest_parser.add_argument(
        "--overlap",
        type=int,
        default=DEFAULT_CHUNK_OVERLAP,
    )

    ingest_parser.set_defaults(
        func=command_ingest
    )

    # --------------------------------------------------------
    # ASK
    # --------------------------------------------------------

    ask_parser = (
        subparsers.add_parser(
            "ask",
            help="Ask one research question.",
        )
    )

    ask_parser.add_argument(
        "question",
        help="Research question.",
    )

    ask_parser.add_argument(
        "--top-k",
        type=int,
        default=DEFAULT_TOP_K,
    )

    ask_parser.add_argument(
        "--max-context-chars",
        type=int,
        default=DEFAULT_MAX_CONTEXT,
    )

    ask_parser.add_argument(
        "--timeout",
        type=int,
        default=180,
    )

    ask_parser.set_defaults(
        func=command_ask
    )

    # --------------------------------------------------------
    # INTERACTIVE
    # --------------------------------------------------------

    interactive_parser = (
        subparsers.add_parser(
            "interactive",
            help="Interactive research session.",
        )
    )

    interactive_parser.add_argument(
        "--top-k",
        type=int,
        default=DEFAULT_TOP_K,
    )

    interactive_parser.add_argument(
        "--max-context-chars",
        type=int,
        default=DEFAULT_MAX_CONTEXT,
    )

    interactive_parser.add_argument(
        "--timeout",
        type=int,
        default=180,
    )

    interactive_parser.set_defaults(
        func=command_interactive
    )

    # --------------------------------------------------------
    # INSPECT
    # --------------------------------------------------------

    inspect_parser = (
        subparsers.add_parser(
            "inspect",
            help="Inspect a source/page.",
        )
    )

    inspect_parser.add_argument(
        "--file",
        required=True,
        help="Exact PDF file name.",
    )

    inspect_parser.add_argument(
        "--page",
        type=int,
        default=None,
        help="1-based page number.",
    )

    inspect_parser.add_argument(
        "--max-chars",
        type=int,
        default=5000,
    )

    inspect_parser.set_defaults(
        func=command_inspect
    )

    # --------------------------------------------------------
    # STATS
    # --------------------------------------------------------

    stats_parser = (
        subparsers.add_parser(
            "stats",
            help="Show library statistics.",
        )
    )

    stats_parser.set_defaults(
        func=command_stats
    )

    # --------------------------------------------------------
    # EVALUATE
    # --------------------------------------------------------

    evaluate_parser = (
        subparsers.add_parser(
            "evaluate",
            help="Evaluate retrieval.",
        )
    )

    evaluate_parser.add_argument(
        "file",
        help="Evaluation JSONL.",
    )

    evaluate_parser.add_argument(
        "--top-k",
        type=int,
        default=DEFAULT_TOP_K,
    )

    evaluate_parser.set_defaults(
        func=command_evaluate
    )

    # --------------------------------------------------------
    # RESET
    # --------------------------------------------------------

    reset_parser = (
        subparsers.add_parser(
            "reset",
            help="Reset index and history.",
        )
    )

    reset_parser.set_defaults(
        func=command_reset
    )

    return parser


# ============================================================
# MAIN
# ============================================================

def main() -> int:

    logging.basicConfig(
        level=logging.INFO,
        format=LOG_FORMAT,
    )

    parser = build_parser()

    args = parser.parse_args()

    try:

        args.func(args)

        return 0

    except KeyboardInterrupt:

        print(
            "\nInterrupted."
        )

        return 130

    except Exception as exc:

        logging.error(
            "Application error: %s",
            exc,
        )

        return 1


if __name__ == "__main__":
    sys.exit(main())
