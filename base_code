class FAISSVectorStore:

    def __init__(
        self,
        embedding_model: str = DEFAULT_EMBEDDING_MODEL,
    ) -> None:

        logging.info(
            "Loading embedding model: %s",
            embedding_model,
        )

        self.encoder = SentenceTransformer(
            embedding_model
        )

        self.index: Optional[
            faiss.Index
        ] = None

        self.chunks: list[Chunk] = []

    @property
    def dimension(self) -> int:

        return int(
            self.encoder
            .get_sentence_embedding_dimension()
        )

    def encode(
        self,
        texts: Iterable[str],
    ) -> np.ndarray:

        texts = list(texts)

        vectors = self.encoder.encode(
            texts,
            convert_to_numpy=True,
            normalize_embeddings=True,
            show_progress_bar=False,
        )

        vectors = np.asarray(
            vectors,
            dtype=np.float32,
        )

        if vectors.ndim == 1:

            vectors = vectors.reshape(
                1,
                -1,
            )

        return vectors

    def add_chunks(
        self,
        chunks: list[Chunk],
    ) -> None:

        if not chunks:
            return

        texts = [
            chunk.text
            for chunk in chunks
        ]

        embeddings = self.encode(
            texts
        )

        if self.index is None:

            self.index = faiss.IndexFlatIP(
                self.dimension
            )

        self.index.add(
            embeddings
        )

        self.chunks.extend(
            chunks
        )

    def search(
        self,
        query: str,
        top_k: int = DEFAULT_TOP_K,
        lexical_weight: float = 0.10,
    ) -> list[SearchResult]:

        if (
            self.index is None
            or len(self.chunks) == 0
        ):

            return []

        query_vector = self.encode(
            [query]
        )

        candidate_k = min(
            top_k * 3,
            len(self.chunks),
        )

        scores, indices = self.index.search(
            query_vector,
            candidate_k,
        )

        results = []

        for raw_score, raw_index in zip(
            scores[0],
            indices[0],
        ):

            index = int(raw_index)

            if index < 0:
                continue

            chunk = self.chunks[index]

            semantic_score = float(
                raw_score
            )

            lexical_score = lexical_overlap(
                query,
                chunk.text,
            )

            # Semantic retrieval stays dominant.
            combined_score = (
                (1 - lexical_weight)
                * semantic_score
                + lexical_weight
                * lexical_score
            )

            results.append(
                SearchResult(
                    chunk=chunk,
                    score=combined_score,
                    semantic_score=semantic_score,
                    lexical_score=lexical_score,
                )
            )

        results.sort(
            key=lambda result: result.score,
            reverse=True,
        )

        return results[:top_k]

    def save(
        self,
        index_file: Path = INDEX_FILE,
        chunks_file: Path = CHUNKS_FILE,
    ) -> None:

        if self.index is None:

            raise RuntimeError(
                "Cannot save an empty index."
            )

        faiss.write_index(
            self.index,
            str(index_file),
        )

        serializable_chunks = [
            asdict(chunk)
            for chunk in self.chunks
        ]

        chunks_file.write_text(
            json.dumps(
                serializable_chunks,
                indent=2,
                ensure_ascii=False,
            ),
            encoding="utf-8",
        )

    def load(
        self,
        index_file: Path = INDEX_FILE,
        chunks_file: Path = CHUNKS_FILE,
    ) -> bool:

        if (
            not index_file.exists()
            or not chunks_file.exists()
        ):

            return False

        self.index = faiss.read_index(
            str(index_file)
        )

        raw_chunks = json.loads(
            chunks_file.read_text(
                encoding="utf-8"
            )
        )

        self.chunks = [
            Chunk(**item)
            for item in raw_chunks
        ]

        if self.index.ntotal != len(
            self.chunks
        ):

            raise RuntimeError(
                "FAISS index and chunk metadata "
                "are inconsistent."
            )

        return True


