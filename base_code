# TOOL LAYER
# ============================================================

class ResearchTools:
    """
    Framework-free local tool layer.

    Tools:
        1. search_documents()
        2. inspect_source()

    Keeping these explicit makes the agentic workflow
    easy to understand and defend in an interview.
    """

    def __init__(
        self,
        store: FAISSVectorStore,
    ) -> None:

        self.store = store

    def search_documents(
        self,
        query: str,
        top_k: int,
    ) -> list[SearchResult]:

        return self.store.search(
            query=query,
            top_k=top_k,
        )

    def inspect_source(
        self,
        file_name: str,
        page: Optional[int] = None,
        max_chars: int = 5000,
    ) -> str:

        matches = [
            chunk
            for chunk in self.store.chunks
            if (
                chunk.file_name.lower()
                == file_name.lower()
            )
            and (
                page is None
                or chunk.page == page
            )
        ]

        if not matches:

            return (
                "No indexed content found "
                f"for {file_name!r}, "
                f"page={page!r}."
            )

        matches.sort(
            key=lambda chunk: (
                chunk.page,
                chunk.chunk_index,
            )
        )

        output = []

        remaining = max_chars

        for chunk in matches:

            if remaining <= 0:
                break

            block = (
                f"File: {chunk.file_name}\n"
                f"Page: {chunk.page}\n\n"
                f"{chunk.text}\n"
            )

            block = block[:remaining]

            output.append(block)

            remaining -= len(block)

        return "\n---\n".join(
            output
        )


# ============================================================
# LIGHTWEIGHT AGENT
# ============================================================

class ResearchAgent:

    def __init__(
        self,
        tools: ResearchTools,
        llm: OllamaClient,
        max_context_chars: int = DEFAULT_MAX_CONTEXT,
    ) -> None:

        self.tools = tools
        self.llm = llm
        self.max_context_chars = (
            max_context_chars
        )

    @staticmethod
    def query_is_weak(
        results: list[SearchResult],
        threshold: float = 0.25,
    ) -> bool:

        if not results:
            return True

        return (
            results[0].score
            < threshold
        )

    @staticmethod
    def expand_query(
        question: str,
    ) -> str:

        # Framework-free query expansion.
        #
        # Useful for research questions where the
        # original wording does not directly match
        # terminology in the paper.

        research_terms = [
            "definition",
            "methodology",
            "results",
            "evidence",
            "limitations",
        ]

        return (
            question.strip()
            + " "
            + " ".join(research_terms)
        )

    @staticmethod
    def merge_results(
        first: list[SearchResult],
        second: list[SearchResult],
        top_k: int,
    ) -> list[SearchResult]:

        best_by_id = {}

        for result in first + second:

            chunk_id = result.chunk.chunk_id

            if (
                chunk_id not in best_by_id
                or result.score
                > best_by_id[
                    chunk_id
                ].score
            ):

                best_by_id[
                    chunk_id
                ] = result

        merged = list(
            best_by_id.values()
        )

        merged.sort(
            key=lambda result: result.score,
            reverse=True,
        )

        return merged[:top_k]

    def answer(
        self,
        question: str,
        top_k: int = DEFAULT_TOP_K,
    ) -> dict:

        start_time = time.perf_counter()

        # ----------------------------------------------------
        # STEP 1 — Initial retrieval
        # ----------------------------------------------------

        initial_results = (
            self.tools.search_documents(
                query=question,
                top_k=top_k,
            )
        )

        final_results = (
            initial_results
        )

        used_expansion = False

        # ----------------------------------------------------
        # STEP 2 — Retrieval self-check
        # ----------------------------------------------------

        if self.query_is_weak(
            initial_results
        ):

            expanded_question = (
                self.expand_query(
                    question
                )
            )

            expanded_results = (
                self.tools.search_documents(
                    query=expanded_question,
                    top_k=top_k,
                )
            )

            final_results = (
                self.merge_results(
                    initial_results,
                    expanded_results,
                    top_k=top_k,
                )
            )

            used_expansion = True

        # ----------------------------------------------------
        # STEP 3 — No evidence
        # ----------------------------------------------------

        if not final_results:

            elapsed_ms = (
                time.perf_counter()
                - start_time
            ) * 1000

            return {
                "answer": (
                    "The indexed documents "
                    "do not provide enough "
                    "evidence to answer this."
                ),
                "sources": [],
                "latency_ms": round(
                    elapsed_ms,
                    2,
                ),
                "query_expansion": (
                    used_expansion
                ),
            }

        # ----------------------------------------------------
        # STEP 4 — Build context
        # ----------------------------------------------------

        context, sources = (
            build_context(
                results=final_results,
                max_chars=(
                    self.max_context_chars
                ),
            )
        )

        # ----------------------------------------------------
        # STEP 5 — Local LLM synthesis
        # ----------------------------------------------------

        user_prompt = (
            build_user_prompt(
                question=question,
                context=context,
            )
        )

        answer_text = (
            self.llm.generate(
                system_prompt=(
                    SYSTEM_PROMPT
                ),
                user_prompt=user_prompt,
                temperature=0.1,
            )
        )

        elapsed_ms = (
            time.perf_counter()
            - start_time
        ) * 1000

        return {
            "answer": answer_text,
            "sources": sources,
            "latency_ms": round(
                elapsed_ms,
                2,
            ),
            "query_expansion": (
                used_expansion
            ),
        }


# ============================================================
# EVALUATION
# ============================================================

def evaluate_retrieval(
    store: FAISSVectorStore,
    evaluation_file: Path,
    top_k: int,
) -> dict:
    """
    Simple retrieval evaluation.

    JSONL example:
        {
            "question": "What methodology is used?",
            "expected_terms": [
                "methodology",
                "proposed method"
            ]
        }

    A query is counted as a hit when at least one
    expected term occurs in the retrieved context.
    """

    total_queries = 0
    successful_queries = 0

    details = []

    tools = ResearchTools(
        store
    )

    with evaluation_file.open(
        "r",
        encoding="utf-8",
    ) as file:

        for line_number, line in enumerate(
            file,
            start=1,
        ):

            if not line.strip():
                continue

            example = json.loads(
                line
            )

            question = str(
                example["question"]
            )

            expected_terms = [
                str(term).lower()
                for term in example.get(
                    "expected_terms",
                    [],
                )
            ]

            results = (
                tools.search_documents(
                    query=question,
                    top_k=top_k,
                )
            )

            combined_text = " ".join(
                result.chunk.text.lower()
                for result in results
            )

            if expected_terms:

                hit = any(
                    term in combined_text
                    for term in expected_terms
                )

            else:

                hit = bool(results)

            total_queries += 1

            successful_queries += int(
                hit
            )

            details.append(
                {
                    "line": line_number,
                    "question": question,
                    "hit": hit,
                    "scores": [
                        round(
                            result.score,
                            4,
                        )
                        for result in results
                    ],
                }
            )

    hit_at_k = (
        successful_queries
        / total_queries
        if total_queries
        else 0
    )

    return {
        "queries": total_queries,
        "hits": successful_queries,
        "hit_at_k": round(
            hit_at_k,
            4,
        ),
        "details": details,
    }


# ============================================================
# STORE LOADING
# ============================================================

def load_store(
    embedding_model: str,
) -> FAISSVectorStore:

    store = FAISSVectorStore(
        embedding_model
    )

    loaded = store.load()

    if not loaded:

        raise RuntimeError(
            "No FAISS index found. "
            "Run the ingest command first."
        )

    return store


# ============================================================
# INGEST COMMAND
# ============================================================

def command_ingest(
    args: argparse.Namespace,
) -> None:

    ensure_directories()

    docs_directory = (
        Path(args.docs)
        .expanduser()
        .resolve()
    )

    if not docs_directory.exists():

        raise FileNotFoundError(
            f"Directory not found: "
            f"{docs_directory}"
        )

    pdf_files = sorted(
        docs_directory.glob(
            "*.pdf"
        )
    )

    if not pdf_files:

        print(
            f"No PDF files found in "
            f"{docs_directory}"
        )

        return

    database = LibraryDatabase()

    store = FAISSVectorStore(
        args.embedding_model
    )

    # Incremental loading:
    # keep existing vectors if available.
    store.load()

    new_documents = 0
    new_chunks = 0

    for pdf_path in pdf_files:

        digest = sha256_file(
            pdf_path
        )

        if database.document_exists(
            digest
        ):

            logging.info(
                "Skipping existing PDF: %s",
                pdf_path.name,
            )

            continue

        logging.info(
            "Processing PDF: %s",
            pdf_path.name,
        )

        # Stable document ID based on file hash.
        doc_id = hashlib.sha1(
            digest.encode(
                "utf-8"
            )
        ).hexdigest()[:16]

        chunks, page_count = (
            build_document_chunks(
                pdf_path=pdf_path,
                doc_id=doc_id,
                chunk_size=args.chunk_size,
                overlap=args.overlap,
            )
        )

        if not chunks:

            logging.warning(
                "No text extracted from %s",
                pdf_path.name,
            )

            continue

        record = DocumentRecord(
            doc_id=doc_id,
            file_name=pdf_path.name,
            file_path=str(pdf_path),
            sha256=digest,
            page_count=page_count,
            added_at=time.time(),
        )

        inserted = (
            database.add_document(
                record
            )
        )

        if not inserted:

            logging.info(
                "Metadata already exists: %s",
                pdf_path.name,
            )

            continue

        store.add_chunks(
            chunks
        )

        new_documents += 1

        new_chunks += len(
            chunks
        )

        logging.info(
            "Added %s | pages=%d | chunks=%d",
            pdf_path.name,
            page_count,
            len(chunks),
        )

    if store.chunks:

        store.save()

    print(
        "\nIngestion completed."
    )

    print(
        f"New documents: {new_documents}"
    )

    print(
        f"New chunks: {new_chunks}"
    )

    print(
        f"Total indexed chunks: "
        f"{len(store.chunks)}"
    )


