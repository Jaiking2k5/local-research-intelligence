def command_ask(
    args: argparse.Namespace,
) -> None:

    ensure_directories()

    store = load_store(
        args.embedding_model
    )

    ollama = OllamaClient(
        base_url=args.ollama_url,
        model=args.ollama_model,
        timeout=args.timeout,
    )

    ollama.health_check()

    tools = ResearchTools(
        store
    )

    agent = ResearchAgent(
        tools=tools,
        llm=ollama,
        max_context_chars=(
            args.max_context_chars
        ),
    )

    database = LibraryDatabase()

    result = agent.answer(
        question=args.question,
        top_k=args.top_k,
    )

    print(
        "\n"
        + "=" * 80
    )

    print(
        "ANSWER"
    )

    print(
        "=" * 80
    )

    print(
        result["answer"]
    )

    print(
        "\n"
        + "-" * 80
    )

    print(
        "SOURCES"
    )

    print(
        "-" * 80
    )

    if result["sources"]:

        for source in result["sources"]:

            print(
                f"[{source['number']}] "
                f"{source['file_name']} "
                f"| page {source['page']} "
                f"| score "
                f"{source['score']}"
            )

    else:

        print(
            "No sources retrieved."
        )

    print(
        "\nLatency: "
        f"{result['latency_ms']} ms"
    )

    print(
        "Query expansion: "
        f"{result['query_expansion']}"
    )

    database.log_query(
        question=args.question,
        answer=result["answer"],
        retrieved_chunks=len(
            result["sources"]
        ),
        latency_ms=result[
            "latency_ms"
        ],
    )


