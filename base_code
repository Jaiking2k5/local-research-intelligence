def ensure_directories() -> None:
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    DOCUMENTS_DIR.mkdir(parents=True, exist_ok=True)


def sha256_file(path: Path) -> str:
    """
    Compute a SHA-256 hash for a file.

    Used to detect whether the same PDF has already been indexed.
    """
    digest = hashlib.sha256()

    with path.open("rb") as file:
        while True:
            block = file.read(1024 * 1024)

            if not block:
                break

            digest.update(block)

    return digest.hexdigest()


def clean_text(text: str) -> str:
    """
    Conservative PDF text cleanup.

    Operations:
    - remove null bytes
    - repair words broken by PDF line wrapping
    - normalize whitespace
    - remove excessive empty lines
    """

    text = text.replace("\x00", " ")

    # Example:
    # architec-
    # ture
    #
    # becomes:
    # architecture
    text = re.sub(
        r"(\w)-\s*\n\s*(\w)",
        r"\1\2",
        text,
    )

    text = re.sub(
        r"[ \t]+",
        " ",
        text,
    )

    text = re.sub(
        r"\n{3,}",
        "\n\n",
        text,
    )

    lines = []

    for line in text.splitlines():
        line = line.strip()

        if line:
            lines.append(line)

    return "\n".join(lines).strip()


def tokenize(text: str) -> set[str]:
    """
    Tokenize text for the small lexical-reranking component.
    """
    tokens = re.findall(
        r"\b[a-zA-Z0-9_./+-]+\b",
        text.lower(),
    )

    return set(tokens)


def lexical_overlap(
    query: str,
    document: str,
) -> float:
    """
    Calculate query/document keyword overlap.

    This is only a secondary ranking feature.
    Semantic embedding similarity remains the main retrieval signal.
    """

    query_tokens = tokenize(query)
    document_tokens = tokenize(document)

    if not query_tokens:
        return 0.0

    intersection = query_tokens.intersection(
        document_tokens
    )

    return len(intersection) / len(query_tokens)


# ============================================================
# PDF EXTRACTION
# ============================================================

def extract_pdf_pages(
    pdf_path: Path,
) -> list[tuple[int, str]]:
    """
    Extract text from each PDF page.

    Returns:
        [(1, page_text), (2, page_text), ...]
    """

    pages = []

    with fitz.open(pdf_path) as pdf:

        for page_number, page in enumerate(
            pdf,
            start=1,
        ):

            text = page.get_text("text")

            text = clean_text(text)

            if text:
                pages.append(
                    (
                        page_number,
                        text,
                    )
                )

    return pages


# ============================================================
# CHUNKING
# ============================================================

def split_text(
    text: str,
    chunk_size: int = DEFAULT_CHUNK_SIZE,
    overlap: int = DEFAULT_CHUNK_OVERLAP,
) -> list[str]:
    """
    Paragraph-aware chunking.

    The objective is to avoid splitting every N characters blindly.

    Strategy:
    - split around paragraphs
    - accumulate paragraphs
    - preserve overlap between consecutive chunks
    - split oversized paragraphs using sliding windows
    """

    if chunk_size <= 0:
        raise ValueError(
            "chunk_size must be greater than 0"
        )

    if overlap < 0 or overlap >= chunk_size:
        raise ValueError(
            "overlap must satisfy 0 <= overlap < chunk_size"
        )

    paragraphs = [
        paragraph.strip()
        for paragraph in re.split(
            r"\n\s*\n",
            text,
        )
        if paragraph.strip()
    ]

    chunks = []

    current = ""

    for paragraph in paragraphs:

        # Handle an unusually large paragraph.
        if len(paragraph) > chunk_size:

            if current:
                chunks.append(
                    current.strip()
                )

                current = ""

            start = 0

            while start < len(paragraph):

                end = start + chunk_size

                window = paragraph[start:end]

                chunks.append(
                    window.strip()
                )

                start += (
                    chunk_size - overlap
                )

            continue

        # Candidate chunk if current paragraph is appended.
        if current:
            candidate = (
                current
                + "\n\n"
                + paragraph
            )
        else:
            candidate = paragraph

        if len(candidate) <= chunk_size:

            current = candidate

        else:

            if current:
                chunks.append(
                    current.strip()
                )

                if overlap > 0:

                    overlap_text = current[
                        -overlap:
                    ]

                    current = (
                        overlap_text
                        + "\n\n"
                        + paragraph
                    )

                else:

                    current = paragraph

    if current.strip():
        chunks.append(
            current.strip()
        )

    return [
        chunk
        for chunk in chunks
        if chunk.strip()
    ]


def build_document_chunks(
    pdf_path: Path,
    doc_id: str,
    chunk_size: int,
    overlap: int,
) -> tuple[list[Chunk], int]:

    pages = extract_pdf_pages(
        pdf_path
    )

    chunks = []

    global_chunk_index = 0

    for page_number, page_text in pages:

        page_chunks = split_text(
            page_text,
            chunk_size=chunk_size,
            overlap=overlap,
        )

        for page_chunk_index, text in enumerate(
            page_chunks
        ):

            chunk = Chunk(
                chunk_id=(
                    f"{doc_id}-"
                    f"chunk-"
                    f"{global_chunk_index}"
                ),
                doc_id=doc_id,
                file_name=pdf_path.name,
                page=page_number,
                chunk_index=page_chunk_index,
                text=text,
                char_count=len(text),
            )

            chunks.append(chunk)

            global_chunk_index += 1

    return chunks, len(pages)


