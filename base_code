def command_interactive(
    args: argparse.Namespace,
) -> None:

    store = load_store(
        args.embedding_model
    )

    ollama = OllamaClient(
        base_url=args.ollama_url,
        model=args.ollama_model,
        timeout=args.timeout,
    )

    ollama.health_check()

    tools = ResearchTools(
        store
    )

    agent = ResearchAgent(
        tools=tools,
        llm=ollama,
        max_context_chars=(
            args.max_context_chars
        ),
    )

    database = LibraryDatabase()

    print()
    print(
        "Local Research Intelligence"
    )
    print(
        "Type a research question."
    )
    print(
        "Type 'exit' or 'quit' to stop."
    )
    print()

    while True:

        try:

            question = input(
                "Research> "
            ).strip()

        except (
            EOFError,
            KeyboardInterrupt,
        ):

            print()
            print(
                "Exiting."
            )

            return

        if question.lower() in {
            "exit",
            "quit",
        }:

            return

        if not question:
            continue

        result = agent.answer(
            question=question,
            top_k=args.top_k,
        )

        print()
        print(
            result["answer"]
        )

        print()
        print(
            "Sources:"
        )

        for source in result[
            "sources"
        ]:

            print(
                f"  [{source['number']}] "
                f"{source['file_name']} "
                f"(page {source['page']})"
            )

        database.log_query(
            question=question,
            answer=result[
                "answer"
            ],
            retrieved_chunks=len(
                result["sources"]
            ),
            latency_ms=result[
                "latency_ms"
            ],
        )

        print()


